<smil>
    <head>
        <!-- media-moved harness: the slot 204+redirects to the shared content URL
             with a version query param (see /moved/redirect in localServer). After
             POST /moved/bump the Location URL changes while the bytes stay the
             same, so the update check detects a mapping-only move (no download)
             and must emit the opt-in media-moved event. -->
        <meta http-equiv="refresh" content="10" updateMechanism="location"/>
        <meta log="true" type="manual" endpoint="http://localhost:3000/report" events="media-moved"/>
        <layout>
            <root-layout width="1920" height="1080" backgroundColor="#000000"/>
            <region regionName="main" left="0" top="0" width="1920" height="1080" z-index="1"/>
        </layout>
    </head>
    <body>
        <par>
            <seq repeatCount="indefinite">
                <img dur="3s"
                     src="http://localhost:3000/moved/redirect/slot-one"
                     region="main" fit="fill"/>
            </seq>
        </par>
    </body>
</smil>
