<smil>
    <head>
        <!-- checkBeforePlay + playCheckSkipOnError combined fixture. Both pre-play
             channels active (content lookahead + playability gate) with STRICT gate
             fail mode on two media types at once:
               - image2 (img) and the video both carry playCheckUrl +
                 playCheckSkipOnError="true": a gate transport error or unlisted 5xx
                 must skip them even though checkBeforePlay is running.
               - image3 carries a default-mode gate (fail-open control).
               - image1 is ungated (rotation-alive control).
             500 is deliberately NOT listed in skipPlaybackOnHttpStatus. The video src
             is a static asset (stable Last-Modified) so the content channel HEADs it
             like any other element; the /cbp images stay server-controllable. -->
        <meta http-equiv="Refresh" content="90" timeOut="2000" checkBeforePlay="true" checkAheadCount="2"
              skipContentOnHttpStatus="404" skipPlaybackOnHttpStatus="403,404,410"/>
        <layout>
            <root-layout width="1920" height="1080" backgroundColor="#18182c"/>
            <region regionName="main" left="0" top="0" width="1920" height="1080"
                    z-index="1" backgroundColor="#18182c"/>
        </layout>
    </head>
    <body>
        <par>
            <seq end="__prefetchEnd.endEvent">
                <seq repeatCount="indefinite">
                    <video src="http://localhost:3000/assets/loader.mp4"/>
                </seq>
            </seq>
            <seq>
                <prefetch src="http://localhost:3000/cbp/image1.png"/>
                <prefetch src="http://localhost:3000/cbp/image2.png"/>
                <prefetch src="http://localhost:3000/cbp/image3.png"/>
                <prefetch src="http://localhost:3000/assets/video-test-2.mp4"/>
                <seq id="__prefetchEnd" dur="1s"/>
            </seq>
            <par begin="__prefetchEnd.endEvent" repeatCount="indefinite">
                <seq repeatCount="indefinite">
                    <img dur="3s" src="http://localhost:3000/cbp/image1.png" region="main" fit="fill"/>
                    <img dur="3s" src="http://localhost:3000/cbp/image2.png" region="main" fit="fill"
                         playCheckUrl="http://localhost:3000/gate/check/image2"
                         playCheckSkipOnError="true"/>
                    <img dur="3s" src="http://localhost:3000/cbp/image3.png" region="main" fit="fill"
                         playCheckUrl="http://localhost:3000/gate/check/image3"/>
                    <video src="http://localhost:3000/assets/video-test-2.mp4" region="main" fit="fill"
                           playCheckUrl="http://localhost:3000/gate/check/video"
                           playCheckSkipOnError="true"/>
                </seq>
            </par>
        </par>
    </body>
</smil>
