<smil>
    <head>
        <!-- List independence: a gate request status (404) listed ONLY in
             skipContentOnHttpStatus must neither skip playback (the gate reads only
             skipPlaybackOnHttpStatus="410") nor mark the content skipContent. -->
        <meta http-equiv="Refresh" content="90"
              skipContentOnHttpStatus="404" skipPlaybackOnHttpStatus="410"/>
        <layout>
            <root-layout width="1920" height="1080" backgroundColor="#18182c"/>
            <region regionName="main" left="0" top="0" width="1920" height="1080"
                    z-index="1" backgroundColor="#18182c"/>
        </layout>
    </head>
    <body>
        <par>
            <seq end="__prefetchEnd.endEvent">
                <seq repeatCount="indefinite">
                    <video src="http://localhost:3000/assets/loader.mp4"/>
                </seq>
            </seq>
            <seq>
                <prefetch src="http://localhost:3000/cbp/image1.png"/>
                <prefetch src="http://localhost:3000/cbp/image2.png"/>
                <prefetch src="http://localhost:3000/cbp/image3.png"/>
                <seq id="__prefetchEnd" dur="1s"/>
            </seq>
            <par begin="__prefetchEnd.endEvent" repeatCount="indefinite">
                <seq repeatCount="indefinite">
                    <img dur="3s" src="http://localhost:3000/cbp/image1.png" region="main" fit="fill"/>
                    <img dur="3s" src="http://localhost:3000/cbp/image2.png" region="main" fit="fill"
                         playCheckUrl="http://localhost:3000/gate/check/image2"/>
                    <img dur="3s" src="http://localhost:3000/cbp/image3.png" region="main" fit="fill"/>
                </seq>
            </par>
        </par>
    </body>
</smil>
