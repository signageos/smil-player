{
  "specials": [
    "mocha",
    "tslint"
  ],
  "parsers": {
    "**/*.ts": "typescript",
    "**/*.js": "es6",
    "**/*.mjs": "es6"
  },
  "detectors": [
    "importDeclaration",
    "requireCallExpression"
  ],
  "ignore-dirs": [
    "dist",
    "packages"
  ],
  "ignores": [
    "@types/*",
    "ts-node",
    "mocha",
    "depcheck",
    "nyc",
    "@signageos/codestyle",
    "mockdate",
    "@signageos/front-applet",
    "es-check",
    "del-cli",
    "json-easy-filter",
    "url",
    "@mdx-js/mdx",
    "cross-env",
    "glob",
    "@signageos/smil-*",
    "events",
    "path-browserify",
    "@signageos/front-display"
  ]
}
